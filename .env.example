# Copy to .env.local for local development, or set in the Node.js hosting environment.
# Never prefix these server-only secrets with NEXT_PUBLIC_.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=info@mydocpro.co.in
SMTP_PASSWORD=replace-with-mailbox-password
CONTACT_FROM_EMAIL=info@mydocpro.co.in
CONTACT_ADMIN_EMAIL=info@mydocpro.co.in
# Optional persistent directory shared by Node workers on the same host.
# CONTACT_RATE_DIR=/var/lib/mydocpro/contact-limits
